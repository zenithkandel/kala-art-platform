<!-- Artists Page -->
<section class="hero">
  <div class="hero__content">
    <h1><i class="fas fa-users"></i> Meet Our Artists</h1>
    <p>Discover talented young artists and their incredible artworks from around the world.</p>
  </div>
</section>

<section class="stats" aria-label="Artist statistics">
  <div class="stats__grid">
    <div class="stat">
      <i class="fas fa-users stat__icon"></i>
      <span class="stat__num" id="totalArtists">0</span>
      <span class="stat__label">Artists</span>
    </div>
    <div class="stat">
      <i class="fas fa-paint-brush stat__icon"></i>
      <span class="stat__num" id="totalArtworks">0</span>
      <span class="stat__label">Artworks</span>
    </div>
    <div class="stat">
      <i class="fas fa-palette stat__icon"></i>
      <span class="stat__num" id="totalSpecialties">0</span>
      <span class="stat__label">Specialties</span>
    </div>
  </div>
</section>

<!-- Artists Controls -->
<section class="section">
  <div class="container">
    <div class="filters">
      <div class="search-box">
        <input 
          type="text" 
          class="input" 
          id="artistSearch" 
          placeholder="Search artists by name, specialty..."
          autocomplete="off"
        >
        <button class="btn btn--secondary" id="searchClear" style="display: none;">
          <i class="fas fa-times"></i> Clear
        </button>
      </div>
      
      <div class="filter-group">
        <label class="filter-label">Sort by:</label>
        <div class="filter-buttons">
          <button class="btn btn--filter active" data-sort="name">
            <i class="fas fa-sort-alpha-down"></i> Name
          </button>
          <button class="btn btn--filter" data-sort="newest">
            <i class="fas fa-clock"></i> Newest
          </button>
          <button class="btn btn--filter" data-sort="popular">
            <i class="fas fa-fire"></i> Popular
          </button>
          <button class="btn btn--filter" data-sort="artworks">
            <i class="fas fa-palette"></i> Most Artworks
          </button>
        </div>
      </div>
      
      <div class="filter-group">
        <label class="filter-label">Specialty:</label>
        <div class="filter-buttons">
          <button class="btn btn--filter active" data-specialty="all">
            <i class="fas fa-globe"></i> All
          </button>
          <button class="btn btn--filter" data-specialty="painting">
            <i class="fas fa-paint-brush"></i> Painting
          </button>
          <button class="btn btn--filter" data-specialty="sculpture">
            <i class="fas fa-cube"></i> Sculpture
          </button>
          <button class="btn btn--filter" data-specialty="digital">
            <i class="fas fa-laptop"></i> Digital Art
          </button>
          <button class="btn btn--filter" data-specialty="photography">
            <i class="fas fa-camera"></i> Photography
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Artists Results -->
<section class="section">
  <div class="container">
    <div class="section-header">
      <div class="results-info" id="resultsInfo">Loading artists...</div>
      <button class="btn btn--primary" id="refreshResults">
        <i class="fas fa-sync-alt"></i> Refresh
      </button>
    </div>
    
    <div class="cards-grid" id="artistsGrid">
      <!-- Artists will be loaded here -->
    </div>
    
    <!-- Loading State -->
    <div class="loading-state" id="loadingSpinner">
      <div class="spinner"></div>
      <p>Loading amazing artists...</p>
    </div>
    
    <!-- Empty State -->
    <div class="empty-state" id="emptyState" style="display: none;">
      <i class="fas fa-users"></i>
      <h3>No artists found</h3>
      <p>Try adjusting your search or filters</p>
    </div>
    
    <!-- Load More -->
    <div class="load-more" id="loadMoreSection" style="display: none;">
      <button class="btn btn--secondary" id="loadMoreBtn">
        <i class="fas fa-chevron-down"></i> Load More Artists
      </button>
  </div>
</section>

<script src="/public/js/artists-page-new.js"></script>
